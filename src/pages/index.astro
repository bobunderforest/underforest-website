---
import Layout from 'ui/layout/Layout.astro'
import { PageLanding } from 'ui/pages/PageLanding'

import { getPageDataMain } from 'modules/page-data/page-data-main'

const pageDataMain = await getPageDataMain()

const meta = {
  metaTitle: 'Dmitrii Podlesnyi — Frontend / Game Developer',
  metaDescription: 'Personal website presenting my work.',
}
---

<Layout meta={meta}>
  <PageLanding client:load pageData={pageDataMain} />
</Layout>
