---
import { THEME_BROWSER_COLORS, THEME_STORAGE_KEY } from 'modules/theme/theme'
---

<script
  is:inline
  define:vars={{
    storageKey: THEME_STORAGE_KEY,
    browserColors: THEME_BROWSER_COLORS,
  }}
>
  function resolveTheme() {
    var stored = null
    try {
      stored = localStorage.getItem(storageKey)
    } catch (error) {}
    if (stored === 'light' || stored === 'dark') return stored
    return window.matchMedia('(prefers-color-scheme: light)').matches
      ? 'light'
      : 'dark'
  }
  function applyTheme(doc) {
    var theme = resolveTheme()
    doc.documentElement.dataset.theme = theme
    var meta = doc.querySelector('meta[name="theme-color"]')
    if (meta) meta.setAttribute('content', browserColors[theme])
  }
  applyTheme(document)
  document.addEventListener('astro:before-swap', function (event) {
    applyTheme(event.newDocument)
  })
</script>

<script is:inline>
  document.addEventListener('click', (event) => {
    const anchor = event.target.closest('a')
    if (anchor && anchor.hash) {
      if (anchor.hash !== window.location.hash) {
        setTimeout(() => {
          window.dispatchEvent(new HashChangeEvent('hashchange'))
        }, 0)
      }
    }
  })
</script>

<script>
  const PREFIX = 'scrollpos:'
  let traversed = false

  window.addEventListener('popstate', () => {
    traversed = true
  })

  document.addEventListener('astro:before-preparation', (event: any) => {
    try {
      const from = event.from?.pathname ?? location.pathname
      sessionStorage.setItem(PREFIX + from, String(window.scrollY))
    } catch {}
  })

  document.addEventListener('astro:page-load', () => {
    const shouldRestore = traversed
    traversed = false
    if (!shouldRestore) return

    let saved: string | null = null
    try {
      saved = sessionStorage.getItem(PREFIX + location.pathname)
    } catch {}
    if (saved == null) return

    try {
      sessionStorage.removeItem(PREFIX + location.pathname)
    } catch {}

    const top = parseInt(saved, 10) || 0
    const apply = () => window.scrollTo(0, top)
    apply()
    requestAnimationFrame(() => {
      apply()
      requestAnimationFrame(apply)
    })
  })
</script>
