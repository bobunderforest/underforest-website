---
import 'styles/global.css'

import Html from 'ui/layout/Html.astro'
import HeadScripts from './HeadScripts.astro'
import { SectionSplash } from 'ui/sections/SectionSplash'
import { SiteRuntime } from 'ui/layout/SiteRuntime'
import { HudNav } from 'ui/features/navigation/HudNav'
import { Footer } from 'ui/layout/Footer'
import { ModalRenderer } from 'modules/modal/ModalRenderer'

import type { MetaData } from 'utils/types/data'

import metaTagsBase from 'app-data/meta-tags.json'

type Props = {
  meta?: MetaData
}

const { meta } = Astro.props

const metaData = {
  metaUrl: metaTagsBase.url,
  ...metaTagsBase.meta,
  ...meta,
}
---

<Html {...metaData}>
  <HeadScripts slot="head" />
  <a class="skip-link" href="#stage">Skip to content</a>
  <HudNav client:load transition:persist="site-nav" />
  <SectionSplash client:load transition:persist="site-splash" />
  <main id="stage">
    <slot />
  </main>
  <Footer client:visible />
  <SiteRuntime client:load transition:persist="site-runtime" />
  <ModalRenderer client:load />
</Html>
